#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TS_ENTRY="$ROOT/packages/mcp-server/src/index.ts"

resolve_rust_bin() {
	if [[ -n "${ARCHITECTURE_READER_MCP_RUST_BIN:-}" && -x "${ARCHITECTURE_READER_MCP_RUST_BIN}" ]]; then
		printf '%s\n' "${ARCHITECTURE_READER_MCP_RUST_BIN}"
		return 0
	fi

	for candidate in \
		"$ROOT/bin/native/architecture-reader-mcp-server" \
		"$ROOT/target/release/architecture-reader-mcp-server" \
		"$ROOT/target/debug/architecture-reader-mcp-server"; do
		if [[ -x "$candidate" ]]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done

	return 1
}

use_ts_transport() {
	[[ "${ARCHITECTURE_READER_MCP_TRANSPORT:-}" == "ts" ]] || [[ "${1:-}" == "ts" ]]
}

if use_ts_transport "$@"; then
	if [[ "${1:-}" == "ts" ]]; then
		shift
	fi
	exec bun "$TS_ENTRY" "$@"
fi

if bin="$(resolve_rust_bin)"; then
	exec "$bin" "$@"
fi

echo "[architecture-reader-mcp] Rust MCP server (rmcp) is not built. Run: bun run build:rust" >&2
exit 1