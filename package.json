{
  "name": "architecture-reader-mcp-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace for Architecture Reader MCP.",
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate:json": "python3 -m json.tool .doctrine/project.json >/dev/null && python3 -m json.tool project.manifest.json >/dev/null",
    "validate": "bun run validate:json",
    "build:rust": "cargo build --release",
    "build": "bun run build:rust",
    "test": "cargo test && bun test",
    "test:public-surface": "bun test test/readmeDiscovery.test.ts",
    "doctor": "bun run packages/mcp-server/src/doctor.ts",
    "benchmark:public-proof": "bun run build:rust && bun run scripts/benchmark-public-proof.ts",
    "benchmark:release-gate": "bun run build:rust && bun run scripts/release-gate.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SylphxAI/architecture-reader-mcp.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@sylphx/synth-js": "^0.2.0"
  }
}
