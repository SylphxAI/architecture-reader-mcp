#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PKG_ROOT="$(cd "$HERE/.." && pwd)"

resolve_rust_bin() {
  if [[ -n "${ARCHITECTURE_READER_MCP_RUST_BIN:-}" && -x "${ARCHITECTURE_READER_MCP_RUST_BIN}" ]]; then
    printf '%s\n' "${ARCHITECTURE_READER_MCP_RUST_BIN}"
    return 0
  fi
  for candidate in \
    "$PKG_ROOT/bin/native/architecture-reader-mcp-server" \
    "$PKG_ROOT/native/architecture-reader-mcp-server" \
    "$PKG_ROOT/../../bin/native/architecture-reader-mcp-server" \
    "$PKG_ROOT/../../target/release/architecture-reader-mcp-server" \
    "$PKG_ROOT/../../target/debug/architecture-reader-mcp-server"; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

if bin="$(resolve_rust_bin)"; then
  exec "$bin" "$@"
fi

echo "[@sylphx/architecture-reader-mcp] Rust MCP server not found." >&2
echo "Build from the product repo (bun run build:rust) or set ARCHITECTURE_READER_MCP_RUST_BIN." >&2
exit 1
